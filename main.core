-- Function na tatawagin kapag nag-expire ang license key gamit ang HexPatch
function applyExpiryCrashPatch()
  pcall(function()
    -- Ginamit ang ibinigay mong format para i-patch ang memory at i-crash ang laro
    HexPatches.MemoryPatch("libunity.so", 0x6A627E0, "h00 00 00 00")
    idkcstmToast("LICENSE EXPIRED: CLOSING GAME!")
  end)
end

